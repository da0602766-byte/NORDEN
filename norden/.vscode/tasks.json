{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NORDEN: preparar dados de demonstracao",
      "type": "process",
      "command": "node",
      "args": ["src/seed.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "NORDEN: iniciar",
      "type": "process",
      "command": "node",
      "args": ["src/server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "NORDEN: preparar dados de demonstracao",
      "problemMatcher": []
    },
    {
      "label": "NORDEN: testar",
      "type": "process",
      "command": "node",
      "args": ["--test", "tests/integration.test.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "NORDEN: build",
      "type": "process",
      "command": "node",
      "args": ["src/build.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
